<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 카메라 공유용. 카메라가 없는 기기(일부 태블릿)에도 설치되게 필수는 아니다. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- usesCleartextTraffic: PC 앱처럼 http LAN 서버도 들어갈 수 있게 한다(마이크는 https 에서만 된다). -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Accord"
        android:resizeableActivity="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- configChanges: 회전·폴드 접고 펴기·창 크기·글꼴 크기·언어 변경에 Activity 를 다시 만들지 않는다(다시 만들면 통화가 끊긴다).
             WebView 가 새 크기로 다시 배치하므로 폰·태블릿·폴드 모두 같은 화면을 쓴다. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback|mediaProjection"
            android:stopWithTask="true" />
    </application>
</manifest>
