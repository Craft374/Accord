# Mac 서버에서 setup-turn-mac.command를 실행하면 server.env가 자동 생성됩니다.
# Windows/Parallels/외부 클라이언트가 Mac 서버에 붙을 때 relay candidate가 없으면 TURN을 확인하세요.

# ── 관리자 계정 시드 ──────────────────────────────────────────────
# 서버 첫 실행 시 고유코드 #0000 의 관리자 계정을 자동으로 만든다.
# (공개 레포에 비밀번호를 넣지 않으려고 env로 분리했음. 이 값은 server.env 에만 넣을 것)
# 로그인 후 반드시 비밀번호를 변경하세요.
ADMIN_SEED_USERNAME=craft374
ADMIN_SEED_PASSWORD=여기에_원하는_비밀번호

# Comma separated STUN URLs. Leave this if you do not know what to use.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Mac에서 Docker coturn을 띄운 경우 setup script가 아래 값을 채웁니다.
TURN_URLS=turn:YOUR_MAC_HOST:3478?transport=udp,turn:YOUR_MAC_HOST:3478?transport=tcp
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password

# ── 게스트 체험 ──────────────────────────────────────────────────
# 채널 초대 코드를 넣으면 로그인 화면에 "게스트로 체험하기" 버튼이 생긴다.
# 누를 때마다 1회용 게스트 계정을 만들어 이 채널에 넣는다. 비워 두면 버튼이 안 보인다.
GUEST_INVITE_CODE=

# ── nginx 등 리버스 프록시 뒤에서 돌릴 때 ────────────────────────
# 1 이면 루프백 연결에 한해 프록시가 넣은 X-Real-IP 를 실제 IP로 쓴다(IP별 연결·로그인 제한이 모두에게 공유되지 않게).
# nginx 에 proxy_set_header X-Real-IP $remote_addr; 가 있어야 한다. Cloudflare 터널에서는 켜지 말 것(헤더 위조 가능).
# HOST=127.0.0.1 을 같이 두면 프록시를 거치지 않은 직접 접속이 막힌다.
TRUST_PROXY=
